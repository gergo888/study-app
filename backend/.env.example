# Copy to backend/.env and adjust. `python manage.py set_password` fills OWNER_PASSWORD_HASH.

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Origin of the Next.js frontend (needed for CSRF when requests are proxied by Next in dev)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Single-user login: hashed password (set via `python manage.py set_password`)
OWNER_PASSWORD_HASH=

# Storage roots (default: <repo>/content, <repo>/data, <repo>/media)
# CONTENT_ROOT=/srv/study-app/content
# DATA_ROOT=/srv/study-app/data
# MEDIA_ROOT=/srv/study-app/media

# Production only: let nginx serve protected files (internal location /protected/ -> MEDIA_ROOT/CONTENT_ROOT)
USE_X_ACCEL_REDIRECT=false

TIME_ZONE=Europe/Budapest
XP_FLASHCARD_CORRECT=10
XP_QUIZ_CORRECT=10
DEFAULT_PAGES_PER_DAY=25
